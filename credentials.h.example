/**
 * @file credentials.h.example
 * @brief Template for local Wi-Fi / HTTP settings.
 *
 * Copy to credentials.h (gitignored) and fill in real values:
 *   cp credentials.h.example credentials.h
 *
 * Used by app_main via wifi_sta_start() and web_ui_start().
 */
#pragma once

/** WPA2 SSID of the home / lab access point. */
static const char *WIFI_SSID = "your-ssid";

/** WPA2 PSK for WIFI_SSID. */
static const char *WIFI_PASSWORD = "your-password";

/** Static IPv4 address assigned to this device. */
static const char *LOCAL_IP = "172.16.21.4";

/** Default gateway on the LAN. */
static const char *GATEWAY = "172.16.21.1";

/** IPv4 subnet mask. */
static const char *SUBNET = "255.255.255.0";

/** Primary DNS resolver. */
static const char *PRIMARY_DNS = "114.114.114.114";

/** Mode UI + OTA HTTP port. */
static const int HTTP_PORT = 80;

/** WebSerial HTTP/WS port. */
static const int WEBSERIAL_PORT = 81;
